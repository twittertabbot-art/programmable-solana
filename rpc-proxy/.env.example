# Programmable RPC proxy. On the server this file is /etc/programmable/rpc.env (read by systemd).
# For a run by hand, copy it to rpc-proxy/.env. Every value but UPSTREAM_RPC has a default; an empty
# value means "use the default". Never share this file: the first value is the provider's key.

# The provider's HTTP address, key included. The browser never sees it. Required.
UPSTREAM_RPC=https://example-provider.invalid/YOUR_KEY

# The provider's WebSocket address. Empty: derived from UPSTREAM_RPC the way web3.js does it
# (wss for https, the same host and path; a port, when the address names one, plus one).
UPSTREAM_WS=
# When the provider's node is locked to the site's origin (Chainstack access rules), the proxy must
# send that origin itself on every upstream request and WebSocket upgrade. Scheme and host only.
UPSTREAM_ORIGIN=

# The browser origins the proxy serves, comma separated, scheme and host only. A request whose Origin
# header names another site is refused with 403 before anything is charged. A request with no Origin
# header at all (a script, a bot, a server) is served, with the same budgets as a page.
# * serves every origin (for a run by hand only).
# Default: https://programmableonsol.com,https://www.programmableonsol.com
ALLOWED_ORIGINS=

# Where to listen. Caddy forwards /rpc here. Default 127.0.0.1 and 8797.
HOST=127.0.0.1
PORT=8797

# A second port that takes WebSocket upgrades only, for a client that derives its WebSocket address as
# the RPC port plus one (the local chain's layout). Empty or 0: off. Not needed behind Caddy.
WS_PORT=

# Budget per client address (an IPv6 address counts by its /64): requests a minute, and how many may
# come at once (the burst). A batch of N requests costs N, a WebSocket connection or message 1.
# Default 60 and 120.
RATE_PER_MINUTE=60
RATE_BURST=120

# sendTransaction per client address a minute. Default 10.
SEND_PER_MINUTE=10

# Requests a day per client address: a budget of this size that refills over 24 hours. Default 20000.
RATE_PER_DAY=20000

# Requests a minute for the whole proxy, all addresses together. Default 1500.
GLOBAL_PER_MINUTE=1500

# Requests a day for the whole proxy, refilled over 24 hours. Default 600000 (the provider's plan has
# 20 million a month).
GLOBAL_PER_DAY=600000

# The largest answer the proxy passes on, in bytes. Larger answers are refused with a JSON-RPC error
# (or cut where they pass it, when the provider does not say their length). Default 8388608 (8 MB).
MAX_ANSWER_BYTES=8388608

# Bytes of answers a minute per client address, and for the whole proxy. Default 52428800 (50 MB) and
# 209715200 (200 MB).
BYTES_PER_MINUTE=52428800
GLOBAL_BYTES_PER_MINUTE=209715200

# Bytes of answers the whole proxy takes at once: what may be streaming at the same moment, so that many
# big answers asked together cannot all be in memory together. Never under MAX_ANSWER_BYTES.
# Default 33554432 (32 MB).
GLOBAL_BYTES_BURST=33554432

# The largest request body, in bytes. Default 65536.
BODY_LIMIT_BYTES=65536

# The most requests in one batch. Default 50: the coin page reads its history as one batch of 50.
BATCH_LIMIT=50

# How long to wait for the upstream, in milliseconds. Default 20000.
UPSTREAM_TIMEOUT_MS=20000

# WebSocket: connections per client address, connections in all, and subscriptions per connection.
# Default 4, 200 and 20.
WS_CONNECTIONS_PER_IP=4
WS_CONNECTIONS_MAX=200
WS_SUBSCRIPTIONS_PER_CONNECTION=20

# WebSocket: the upstream socket of a connection is closed after this many seconds with no live
# subscription (the client's socket stays open). Default 60.
WS_IDLE_SECONDS=60

# WebSocket: messages a minute per connection; past it the connection is closed. Default 120.
WS_FRAMES_PER_MINUTE=120

# The JSON-RPC methods that pass, comma separated. Empty: the list in lib/config.mjs (what the site
# and the SDK call). Everything else is refused with error -32601.
METHODS=

# The methods that pass on the WebSocket. Empty: signatureSubscribe, signatureUnsubscribe, ping.
WS_METHODS=

# A summary line in the log every this many seconds. 0: never. Default 300.
SUMMARY_EVERY_SECONDS=300
