# hookpool watcher configuration. Copy this file to watcher/.env and edit it.
# watcher/.env is gitignored. Every value has a default; an empty value means "use the default".

# Solana RPC. localnet: http://127.0.0.1:8899   devnet: https://api.devnet.solana.com
# mainnet: a paid endpoint is strongly recommended, the public one rate limits simulations.
RPC_URL=http://127.0.0.1:8899

# localnet, devnet or mainnet. Used in the status file and in the explorer links of the alerts.
CLUSTER=localnet

# Seconds between two passes over all pools. Default 60. Minimum 5.
INTERVAL_SECONDS=60

# Size of the simulated buy, in SOL. Default 0.05. The probe wallet must hold at least this plus about 0.01 SOL.
PROBE_SOL=0.05

# Keypair file of the probe wallet (the usual solana JSON array). If the file does not exist the watcher creates
# one there. On localnet the watcher airdrops SOL to it by itself. On mainnet YOU fund it with about 0.1 SOL:
# its trades are simulations and never spend the SOL; it also pays 5,000 lamports for each collectible reveal,
# settle, deliver or reap transaction, and for each buyback or burn, that it sends as the keeper (see
# REVEAL_INTERVAL_SECONDS, SETTLE_INTERVAL_SECONDS, UPKEEP_INTERVAL_SECONDS, BURN_INTERVAL_SECONDS and
# KEEPER_MIN_LAMPORTS below). The burn keeper is the one duty that earns nothing back: with many buyback and
# rules pools, look at the balance now and then.
PROBE_KEYPAIR=state/probe-keypair.json

# HTTP port for GET /pools.json and GET /health. Default 8790.
PORT=8790

# Telegram alerts. Leave both empty to log alerts to stdout only.
# Bot token from @BotFather. Chat id: message your bot once, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read "chat":{"id":...} out of the answer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The same alert (same pool, same text) is not repeated within this many seconds. Default 3600.
ALERT_COOLDOWN_SECONDS=3600

# The reveal crank (collectible template). Seconds between two crank passes, independent of INTERVAL_SECONDS.
# Default 20, allowed 5 to 60: a batch must be revealed within 512 slots (about 3.5 minutes) or it expires.
REVEAL_INTERVAL_SECONDS=20

# The settle crank (collectible template). Seconds between two settle passes, independent of the others.
# Default 10, allowed 5 to 3600. Pieces are pegged to the coin: a wallet keeps one piece per unit of coins it
# holds. This crank burns the pieces of wallets whose coins left without a settle (a plain transfer, a sell
# made with another client). The rent of every burned piece is paid to the keeper, so the crank pays for itself.
# Its tickets come from the ticket index (state/tickets.json, read by address): no read of the whole program.
# With the feed on, a pass reads only the tickets of the wallets the feed saw trade or earn pieces in the last five
# minutes, and a feed pass that reads a sell wakes it at once: a sell made with another client is settled within
# about ten seconds.
SETTLE_INTERVAL_SECONDS=10

# How often the settle crank reads every indexed ticket, in seconds. Default 300, allowed 10 to 86400. That sweep
# settles what no pool transaction shows: a plain transfer of coins to another wallet. With the feed off every
# pass reads every ticket.
SETTLE_SWEEP_SECONDS=300

# The upkeep crank (collectible template, pegged coins only). Seconds between two upkeep passes, independent of
# the others. Default 10, allowed 5 to 3600. A pegged coin is a Token-2022 coin that runs the collectible
# program inside every transfer: the wallet lists change in the transfer itself. This crank makes the Metaplex
# assets follow, for transfers made outside the site: it delivers the pieces that moved and burns the pieces
# that burned. A burn pays the rent of the asset and of its burn queue entry to the keeper. A delivery earns
# nothing. Short on purpose: a holder looks at its wallet right after a transfer.
UPKEEP_INTERVAL_SECONDS=10

# The burn keeper (buyback template and launch rules template). Both collect a share of every trade to buy
# the coin back and burn it, and both rely on somebody calling that buy regularly, so that the pots stay small.
# on or off. Default on. --no-burn on the command line turns it off too.
BURN_KEEPER=on

# Seconds between two passes of the burn keeper, independent of the others. Default 30, allowed 5 to 3600.
# The chain takes a call on a pool at most once every 25 slots (about ten seconds).
BURN_INTERVAL_SECONDS=30

# The most calls one pass sends, one per pool. Default 10, allowed 1 to 100. More pools than this wait for the
# next pass, which then starts two seconds later.
BURN_MAX_CALLS=10

# A pot under this many lamports is left alone. Default 100000 = 0.0001 SOL. A call costs the keeper 5,000
# lamports and earns it nothing, and a coin without a burn rate still collects a few lamports of rounding.
BURN_MIN_POT_LAMPORTS=100000

# How far under the SDK's quote a buy of the keeper may land before the chain refuses it, in basis points.
# Default 100 = 1%. Allowed 0 to 5000.
BURN_SLIPPAGE_BPS=100

# The holder sync of strict coins, in the burn keeper's pass. A strict coin pays its holders' share to wallets
# with a holder record, on what the record counted at the wallet's last transfer. A token Burn calls no
# transfer hook, so the record of a wallet that burned coins keeps counting them until somebody sends
# sync_holder. on or off. Default on. Off whenever the burn keeper is off.
HOLDER_SYNC=on

# A record is synced when it stands above its wallet's coins by at least this share of all the coins in holder
# records, in basis points: that is the part of the holders' share it takes that it should not. Default 10 =
# 0.1%. Allowed 0 to 10000. Each sync costs the keeper 5,000 lamports for up to five records.
HOLDER_SYNC_MIN_BPS=10

# The graduate crank (coins launched on the curve). A pool on the curve that holds its graduation target of
# real SOL keeps trading on the curve until somebody sends graduate. The SDK puts it into the trade that gets
# there; this crank sends it for the pools a trade built elsewhere left past their target. Once per coin,
# 5,000 lamports, nothing earned. on or off. Default on. --no-graduate on the command line turns it off too.
GRADUATE_KEEPER=on

# Seconds between two passes of the graduate crank, independent of the others. Default 15, allowed 5 to 3600.
GRADUATE_INTERVAL_SECONDS=15

# The mint crank (collectible template, one approval). A buy that earns pieces can pay their rent as a deposit in
# the buy itself (the site and the trade API add it). The keeper then mints the pieces into the buyer's wallet with
# the permissionless mint_for, a few seconds after the buy, and the deposit pays it back what it spent plus 10,000
# lamports: the crank pays for itself. It sends a mint only when the deposit covers it and a simulation shows the
# keeper no poorer afterwards. on or off. Default on. --no-mint or --no-crank on the command line turns it off too.
# Off, the buyers' pieces wait until the buyer mints them on the coin page (its deposit pays that mint too).
# A mint makes the keeper pay the NFTs' rent first and the deposit pays it back at the end of the same transaction:
# keep at least 0.05 SOL in the keeper wallet (KEEPER_MIN_LAMPORTS=50000000), about 0.018 SOL for a mint of four.
MINT_CRANK=on

# Seconds between two passes of the mint crank's own poll, independent of the others. Default 60, allowed 1 to 3600.
# The buys reach the crank from the trades feed (every buy is a transaction of the pool program the feed reads
# anyway) and from POST /notify (the coin page, right after its buy landed), at no extra call: the poll (one
# getSignaturesForAddress on the collectible program) is only the safety net. While a wallet waits for its deciding
# block (about one second) the passes come every half second.
MINT_INTERVAL_SECONDS=60

# Seconds between two reads of the indexed tickets, to find a deposit the feed and the poll missed (the watcher was
# down, a deposit sent on its own). Default 300, allowed 30 to 86400. The start reads them once too.
MINT_SWEEP_SECONDS=300

# POST /notify: the coin page hands the watcher the signature of a buy that paid a deposit, so that the keeper mints
# right after the buy's block. on or off. Default on. Off whenever the mint crank is off. Only the signature is
# taken from the caller: its status is asked first (one call for every signature waiting, at most once a second),
# a signature the chain does not know is dropped with no other call, and a known one's transaction is read (at most
# twice) and must be a buy of the pool program that earned pieces. A notification never makes the watcher read
# every ticket.
NOTIFY=on

# How many signatures one address may hand in a minute. Default 3, allowed 1 to 600. More answer 429; the keeper
# finds the buy by itself through the feed within a feed pass anyway. Behind a proxy on the same machine the address
# is the last X-Forwarded-For entry that is not a private network address (the one the proxy added).
NOTIFY_PER_MINUTE=3

# How many signatures everybody together may hand in a minute. Default 30, allowed 1 to 6000.
NOTIFY_GLOBAL_PER_MINUTE=30

# The ticket index: state/tickets.json knows every ticket of the collectible program by address, fed by the buys
# the feed and the mint crank see. The whole program is listed again (one getProgramAccounts, addresses only) when
# the index is empty at the start and then every this many seconds, to find tickets the feed did not see.
# Default 3600, allowed 600 to 86400. A listing that fails is tried again after 1, 2, 4, ... minutes.
TICKET_RECONCILE_SECONDS=3600

# Where the ticket index lives. Default: tickets.json next to STATE_FILE (state/tickets.json here). Safe to delete:
# the next start lists the program again.
TICKET_INDEX_FILE=state/tickets.json

# A priority fee for the keeper's mints, in micro-lamports a compute unit. Default 0. Allowed 0 to 20000: a mint asks
# for 250,000 compute units and the fee is charged on that limit, so at 20,000 the network fee of a mint reaches the
# 10,000 lamports the deposit pays the keeper, and above it the keeper would pay to mint.
MINT_PRIORITY_MICROLAMPORTS=0

# The probe wallet is also the keeper that signs and pays the reveals, the settles, the deliveries, the burns
# of pieces, the buybacks and burns of coins, and the graduations: 5,000 lamports per transaction. Below this balance the
# watcher sends a danger alert (devnet and mainnet), for every crank. Default 10000000 = 0.01 SOL. The keeper
# needs this small balance even though settles and burns of pieces earn rent: the first fee is paid before any
# rent comes in, and the burn keeper earns nothing at all.
KEEPER_MIN_LAMPORTS=10000000

# The trades feed and market.json: the recent trades of every pool and every pool with what a coin card shows,
# served at /trades/<pool>.json and /market.json so that the website does not read the chain for them. on or off.
# Default on. --no-feed on the command line turns it off too.
FEED=on

# Where the feed's lock lives (one feed per set of files: a second watcher on the same files runs without the feed).
# Empty: next to FEED_STATE_FILE. On a server with the systemd unit: /run/programmable-watcher, the service's runtime
# folder (RuntimeDirectory=), which every reboot empties. The lock also names the machine's boot and the process's
# start, so one left behind is never taken for a running watcher.
LOCK_DIR=

# Seconds between two feed passes. Each pass is one list of the pool program's new transactions, plus the ones
# that arrived. Default 10, allowed 2 to 3600.
FEED_INTERVAL_SECONDS=10

# The pools a feed pass's transactions touched are read again by address (one getMultipleAccountsInfo per hundred)
# in that pass. Every pool is read in one getProgramAccounts only as a reconciliation, this often: at the start,
# after a gap of the feed, and every this many seconds. Default 1800, allowed 30 to 86400. A read of every pool
# that fails is tried again after 30 s, 60, ..., 15 minutes at most, and raises one alert after an hour.
MARKET_REFRESH_SECONDS=1800

# A pool with a hook is simulated again when anything its simulations depend on changed, while a launch window
# runs, and at least this often, in minutes. Default 60, allowed 1 to 1440.
SIM_MAX_AGE_MINUTES=60

# The platform's approved list: each pass compares the rule and the list with the last pass (an alert on a change)
# and says per pool where its hook stands (hookApproval in pools.json). on or off. Default on. No call of its own.
APPROVAL_WATCH=on

# The manifest and the extra-accounts list of every hook program a pool uses, hashed each pass from the bytes the
# pass reads anyway: an alert when one changes. on or off. Default on. No call of its own.
HOOK_ACCOUNTS_WATCH=on

# Sells as recent buyers: for a pool whose hook runs on sells, when its simulations run and the sell probe went
# through, a sell of 1% as up to HOLDER_SIMS_PER_POOL wallets that bought lately and still hold the coin. A hook
# that refuses some of them is a danger alert. HOLDER_SIMS is the most of these simulations one pass runs in all
# (default 30, allowed 0 to 1000; 0 or off turns the check off). HOLDER_SIMS_PER_POOL: default 3, allowed 1 to 10.
HOLDER_SIMS=30
HOLDER_SIMS_PER_POOL=3
